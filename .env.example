# Copy to .env (never committed) and fill in.
# API credentials from https://addons.mozilla.org/developers/addon/api/key/
WEB_EXT_API_KEY=user:00000000:000
WEB_EXT_API_SECRET=put-your-secret-here

# Optional: "unlisted" (default, only you get the signed file) or "listed" (published on AMO)
AMO_CHANNEL=unlisted

# Optional: folder the signed .xpi is copied to
RELEASE_DIR=
